<?xml version="1.0"?>
<phpunit
	bootstrap="tests/phpunit/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	>
	<testsuites>
		<testsuite name="Abilities for EDD Test Suite">
			<directory suffix="-test.php">./tests/phpunit/unit-tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
